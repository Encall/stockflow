MLFLOW_TRACKING_URI=http://localhost:5000
# MLflow connection (docker compose → http://mlflow:5000, local testing → http://localhost:5000)
MLFLOW_TRACKING_URI=http://localhost:5000

# Comma-separated experiments to search (optional). Leave blank to use prefix/all.
MLFLOW_EXPERIMENT_NAMES=

# Prefix for per-stock experiments (e.g., stock_DIG, stock_NVDA)
MLFLOW_EXPERIMENT_PREFIX=stock_

# Tag key on runs to identify stock (payload.stock is matched to this)
MLFLOW_STOCK_TAG_KEY=stock

# Tag that marks a run as production
MLFLOW_PRODUCTION_TAG_KEY=production
MLFLOW_PRODUCTION_TAG_VALUE=true

# Path inside the run where the pyfunc model is logged
MLFLOW_MODEL_ARTIFACT_PATH=model

# Optional primary metric and order for picking the best production-tagged run
MLFLOW_PRIMARY_METRIC=
MLFLOW_PRIMARY_METRIC_ORDER=desc

# S3/MinIO settings if artifacts are stored there
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
MLFLOW_S3_ENDPOINT_URL=
