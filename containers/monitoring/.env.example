# Object storage (AWS S3 / MinIO) connection
AWS_S3_ENDPOINT_URL=https://your-s3-endpoint
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=stockflow
AWS_S3_SECURE=true

# Rolling window drift inputs (gold/parquet inside the bucket)
# Leave MONITORING_STOCK_SYMBOL empty to load all symbols; otherwise set e.g., DIG
MONITORING_STOCK_SYMBOL=
# Comma-separated list of features to keep; leave empty to use all columns except date/target
MONITORING_FEATURES=open,high,low,volume
MONITORING_TARGET=close
# Options: standard | minmax | none
MONITORING_SCALER=standard
# Local cache for downloaded gold parquet files
MONITORING_GOLD_CACHE=data/gold
# Window sizing: window_size must be exactly 2 * split_size
MONITORING_WINDOW_SIZE=60
MONITORING_SPLIT_SIZE=30

# Drift report output options (reports uploaded to this bucket prefix)
MONITORING_SAVE_DIR=reports/data_drift
MONITORING_FILE_PREFIX=drift_report
MONITORING_SAVE_HTML=true
MONITORING_SAVE_JSON=true
# Emit XCom-friendly JSON payload on stdout (for Airflow BashOperator do_xcom_push)
MONITORING_EMIT_XCOM=false
